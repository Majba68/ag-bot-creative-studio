{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build -w server && npm run build -w client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": [
        "server/data/creative-studio/**",
        "server/src/data/*.json",
        "server/dist/data/**",
        "server/data/trapo/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
