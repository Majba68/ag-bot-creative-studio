# Copy this file to server/.env and fill in the keys you have.
# Never commit your real .env file.

# HTTP server port
PORT=3001

# Market data (real forex candles). Get a free key at https://twelvedata.com
TWELVEDATA_API_KEY=

# Optional AI explanation / chat / screenshot vision.
# Supported providers: openai | anthropic | gemini | none
# For free Gemini: create a key at https://aistudio.google.com/apikey, then set:
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=YOUR_GEMINI_KEY
#   LLM_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Required for the AG AI VISION ANALYZER tab. Set this to a model you know is
# vision-capable. Examples: gemini-3.5-flash-lite (free tier), gpt-4o,
# claude-3-5-sonnet-latest. There is deliberately no default: without this,
# vision analysis stays disabled and the UI shows "Vision AI Not Configured".
VISION_MODEL=

# Optional local interface testing only. When true, all chart and analysis
# figures are locally generated simulated data, clearly labelled in the UI.
# Keep this false unless you explicitly want simulated data.
DEMO_MODE=false

# Allowed browser origin during development
CLIENT_ORIGIN=http://localhost:5173
